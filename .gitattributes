# Normaliza fim de linha para evitar diffs falsos entre Windows e Linux.
* text=auto eol=lf

# Binários — nunca converter
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.ogg binary
*.mp3 binary
*.wav binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary

# Scripts do Windows continuam com CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Linguagens
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Evita marcar lockfiles como gerados automaticamente em linguagens erradas
pubspec.lock linguist-generated=true
