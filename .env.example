# ============================================================
#  Imperiall Game — variáveis de ambiente
#  Copie este arquivo para `.env` e preencha com seus valores.
#  O `.env` está no .gitignore e NUNCA deve ser commitado.
#
#  Uso:
#    flutter run --dart-define-from-file=.env
# ============================================================

# --- Supabase (Project Settings > API) ---
# URL pública do projeto, ex.: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Chave pública ANON. É seguro expô-la no app: o acesso é controlado por RLS.
SUPABASE_ANON_KEY=

# --- App ---
# `false` liga o modo conectado (exige SUPABASE_URL + SUPABASE_ANON_KEY):
# o app abre na tela de login e salva o progresso no Supabase.
# `true` (padrão) abre com dados de demonstração, sem backend.
DEMO_MODE=true

# Ambiente: dev | staging | prod
APP_ENV=dev

# --- NÃO ADICIONE AQUI ---
# service_role key, senha do banco, keystore e tokens ficam APENAS em
# GitHub Secrets / cofre do time. Nunca no app nem neste arquivo.
